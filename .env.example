# Runtime
NODE_ENV=development
PORT=4000

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=doctor-tracker

# Optional, local dev only: if you see "querySrv ECONNREFUSED", your machine's DNS proxy is
# refusing SRV lookups. Point Node at public DNS instead. Leave unset in production.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed browser origins (the frontend URL)
CORS_ORIGINS=http://localhost:3000

# Reverse proxies in front of the API: 1 locally / direct, 2 in production (Vercel rewrite -> Render)
TRUST_PROXY_HOPS=1

# Seed script — demo admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@doctortracker.app
SEED_ADMIN_PASSWORD=replace-with-a-strong-password



